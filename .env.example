# ============================================================================
# COPY this file to .env and fill in REAL values before running the app.
# NEVER commit .env to version control — it is already in .gitignore.
# The app will REFUSE to start without JWT_SECRET, ADMIN_EMAIL, ADMIN_PASSWORD.
# ============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Admin Authentication (REQUIRED — app will not start without these)
# Generate a strong JWT_SECRET with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ADMIN_EMAIL=your-real-email@yourdomain.com
ADMIN_PASSWORD=USE_A_STRONG_PASSWORD_HERE
JWT_SECRET=GENERATE_A_RANDOM_SECRET_WITH_THE_COMMAND_ABOVE

# Database
DB_PATH=store.db

# Logging
LOG_LEVEL=dev

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# CORS — comma-separated allowed origins (leave empty for same-origin only)
# Example: CORS_ORIGIN=https://yourdomain.com,https://admin.yourdomain.com
CORS_ORIGIN=

# Google Gemini AI (required for AI shopping assistant)
# Get your free API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash-lite

# Cash App Payment (configured in admin panel)
CASH_APP_ENABLED=true
CASH_APP_CASHTAG=yourcashtag
CASH_APP_PAYMENT_LINK=