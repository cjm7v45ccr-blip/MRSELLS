# ============================================================================
# COPY this file to .env and fill in REAL values before running locally.
# NEVER commit .env to version control — it is already in .gitignore.
#
# FOR RENDER DEPLOYMENT:
# Do NOT use this file. Instead, set these environment variables in the
# Render Dashboard under your Web Service -> Environment Variables.
# The app will use default/demo credentials if not set, but you MUST set
# ADMIN_EMAIL, ADMIN_PASSWORD, and JWT_SECRET for production security.
# ============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Admin Authentication
# Generate a strong JWT_SECRET with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ADMIN_EMAIL=admin@store.com
ADMIN_PASSWORD=admin123
JWT_SECRET=storefront-jwt-secret-change-me

# Database (stores data in a local file - persists across restarts on Render with disk)
DB_PATH=store.db

# Logging
LOG_LEVEL=dev

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# CORS — comma-separated allowed origins (leave empty for same-origin only)
# Example: CORS_ORIGIN=https://yourdomain.com,https://admin.yourdomain.com
CORS_ORIGIN=

# Google Gemini AI (required for AI shopping assistant)
# Get your free API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash-lite

# Cash App Payment (configured in admin panel)
CASH_APP_ENABLED=true
CASH_APP_CASHTAG=yourcashtag
CASH_APP_PAYMENT_LINK=